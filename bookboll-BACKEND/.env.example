APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5174
ADMIN_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bookboll_backend
DB_USERNAME=root
DB_PASSWORD=
DB_DUMP_BINARY_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=
# REDIS_PREFIX=
# SESSION_COOKIE=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Spatie Laravel Backup (scheduled in routes/console.php — run `php artisan schedule:run` every minute on the server)
# BACKUP_NOTIFICATION_TO=ops@example.com
# BACKUP_ARCHIVE_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Supabase (used by ClassMembershipFromSupabaseSeeder only — prefer service role)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required to seed RLS-protected tables (provider_wallets, withdrawals, etc.)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-only — set here, not in the admin UI or database)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Laravel Cashier aliases (same values as above)
STRIPE_KEY="${STRIPE_PUBLIC_KEY}"
STRIPE_SECRET="${STRIPE_SECRET_KEY}"

# OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Google OAuth (customer login)
GOOGLE_CLIENT_ID=

# Apple Sign In (customer login) — iOS bundle ID; comma-separate extra audiences if needed
APPLE_CLIENT_ID=com.bookboll.app

# Support & admin
SUPPORT_EMAIL=
ADMIN_MASTER_PASSWORD=

# Admin mobile app API header validation
API_MOBILE_APP_HEADER=from
API_MOBILE_APP_VALUE=admin_mobile_app

# Cloudflare Turnstile (admin web login)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set to true to require Turnstile on login in local. Defaults to off when APP_ENV=local.
TURNSTILE_ENABLED=

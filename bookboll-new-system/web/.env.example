# Production:
VITE_WEB_URL=https://bookboll.com
VITE_ADMIN_URL=https://admin.bookboll.com
VITE_API_URL=https://backend.bookboll.com/api
VITE_BUSINESS_URL=https://business.bookboll.com
# Staging hosts that behave like localhost for white-label previews: `?b=<slug>` and
# `?bid=<owner>&preview=1` are honoured there and the host is never read as a provider slug.
# Comma-separated, exact hostnames. bookboll.com itself is ignored if listed.
VITE_PREVIEW_HOSTS=

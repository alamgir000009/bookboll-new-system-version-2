# Production:
VITE_WEB_URL=https://bookboll.com
VITE_ADMIN_URL=https://admin.bookboll.com
VITE_API_URL=https://backend.bookboll.com/api
VITE_BUSINESS_URL=https://business.bookboll.com


# VITE_WEB_URL=http://localhost:5173
# VITE_ADMIN_URL=http://localhost:5174
# VITE_BUSINESS_URL=http://localhost:5175

# Staging:
# VITE_WEB_URL=https://bookboll.com
# VITE_ADMIN_URL=https://admin.bookboll.com
# VITE_BUSINESS_URL=https://business.bookboll.com
# VITE_API_URL=https://newbackend.bookboll.com/api

# Google sign-in needs no key here: the browser never talks to Google. It goes
# through the broker at VITE_API_URL/auth/google/start, which holds the one OAuth
# client — that is what lets tenant subdomains and custom domains sign in at all.

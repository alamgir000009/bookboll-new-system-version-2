# Production:
VITE_WEB_URL=https://bookboll.com
VITE_ADMIN_URL=https://admin.bookboll.com
VITE_API_URL=https://backend.bookboll.com/api
VITE_BUSINESS_URL=https://business.bookboll.com

# Pusher (public key only — secret is on Laravel .env)
VITE_PUSHER_SCHEME=https
VITE_PUSHER_APP_CLUSTER=ap2
VITE_PUSHER_APP_KEY=cff5ab68e3f5c53ddfad
# Staging storefront hosts where `?b=<slug>` previews work (comma-separated, exact).
# When VITE_WEB_URL points at one of these, "open my site" / preview links use ?b= instead
# of <slug>.bookboll.com, which would be production.
VITE_PREVIEW_HOSTS=

# Google Maps (venue form: map picker, place search, reverse geocoding).
# Browser key — restrict it to this admin host and to the Maps JavaScript,
# Places and Geocoding APIs in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
# Optional map style id (Advanced Markers need one; Google's DEMO_MAP_ID is used when blank).
VITE_GOOGLE_MAPS_MAP_ID=
